# Copy this file to .env and fill in your own credentials.
# .env is gitignored, so your real credentials are never pushed to GitHub.
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.<clusterid>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=plantcare
PORT=3001

# OAuth with GitHub. The callback URL has to match the Authorization callback URL
# of the GitHub OAuth app character for character, including https and no trailing slash.
GITHUB_CLIENT_ID=<your github oauth client id>
GITHUB_CLIENT_SECRET=<your github oauth client secret>
CALLBACK_URL=https://<your-service>.onrender.com/auth/github/callback

# Random string used to sign the session cookie. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=<long random string>

# Origin allowed to send credentialed (cookie) requests, comma separated.
# Leave it set to the public URL of the API in production.
CORS_ORIGIN=http://localhost:3001

# production turns on the secure flag of the session cookie, which requires https.
NODE_ENV=development

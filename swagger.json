{
    "swagger": "2.0",
    "info": {
        "title": "Plant Care API",
        "description": "REST API to create, read, update and delete houseplants and their care logs, stored in MongoDB. Reading is public, every route that changes data requires a session started with GitHub OAuth.",
        "version": "1.0.0"
    },
    "host": "project2-shmi.onrender.com",
    "basePath": "/",
    "tags": [
        {
            "name": "Home",
            "description": "Base route of the Plant Care API"
        },
        {
            "name": "Auth",
            "description": "Log in and log out with GitHub using OAuth"
        },
        {
            "name": "Plants",
            "description": "CRUD operations on the plants collection"
        },
        {
            "name": "Care Logs",
            "description": "CRUD operations on the careLogs collection"
        }
    ],
    "schemes": [
        "https"
    ],
    "securityDefinitions": {
        "sessionCookie": {
            "type": "apiKey",
            "in": "cookie",
            "name": "plantcare.sid",
            "description": "Session cookie set by GET /auth/github. Log in from a browser first, then every request from this page carries it. The protected routes below answer 401 without it."
        }
    },
    "paths": {
        "/": {
            "get": {
                "tags": [
                    "Home"
                ],
                "summary": "Welcome message and session status",
                "description": "Base route of the Plant Care API. It also says whether there is an active session, and points to the log in, log out and documentation links.",
                "produces": [
                    null
                ],
                "responses": {
                    "200": {
                        "description": "OK - Returns a welcome message with the current session status."
                    }
                }
            }
        },
        "/auth/github": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Log in with GitHub",
                "description": "Starts the OAuth handshake. GitHub sends the browser back to /auth/github/callback, which stores the user in the session and returns to the home page. Use it from a browser, it answers with a redirect to github.com.",
                "produces": [
                    "text/html"
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to the GitHub authorization page."
                    },
                    "400": {
                        "description": "Bad Request - This server is not the one registered as the OAuth callback."
                    },
                    "503": {
                        "description": "Service Unavailable - The GitHub OAuth credentials are not configured on the server."
                    }
                }
            }
        },
        "/auth/github/callback": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "GitHub OAuth callback",
                "description": "The URL GitHub redirects to after the user authorizes the app. It saves the profile in the users collection, opens the session and redirects to the home page. Not called by hand.",
                "produces": [
                    "text/html"
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to the home page once the session is open."
                    },
                    "401": {
                        "description": "Unauthorized - GitHub did not return a valid authorization code."
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/auth/logout": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Log out",
                "description": "Closes the session, clears the session cookie and redirects to the home page.",
                "produces": [
                    "text/html"
                ],
                "responses": {
                    "302": {
                        "description": "Redirect to the home page."
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            },
            "post": {
                "tags": [
                    "Auth"
                ],
                "summary": "Log out and answer with JSON",
                "description": "Same as GET /auth/logout but returns JSON, which is the one to use from the Swagger docs.",
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK - The session was closed.",
                        "schema": {
                            "$ref": "#/definitions/MessageResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            }
        },
        "/auth/me": {
            "get": {
                "tags": [
                    "Auth"
                ],
                "summary": "Get the logged in user",
                "description": "Returns the GitHub profile stored for the current session. Answers 401 when nobody is logged in.",
                "produces": [
                    "application/json"
                ],
                "responses": {
                    "200": {
                        "description": "OK - Returns the session user.",
                        "schema": {
                            "$ref": "#/definitions/SessionUser"
                        }
                    },
                    "401": {
                        "description": "Unauthorized - There is no active session.",
                        "schema": {
                            "$ref": "#/definitions/AuthError"
                        }
                    }
                }
            }
        },
        "/plants/{id}": {
            "get": {
                "tags": [
                    "Plants"
                ],
                "summary": "Get a plant by id",
                "description": "Returns a single plant matching the provided id.",
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "MongoDB ObjectId of the plant"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK - Returns the requested plant.",
                        "schema": {
                            "$ref": "#/definitions/Plant"
                        }
                    },
                    "400": {
                        "description": "Bad Request - The id is not a valid ObjectId."
                    },
                    "404": {
                        "description": "Not Found - No plant exists with that id."
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            },
            "put": {
                "tags": [
                    "Plants"
                ],
                "summary": "Update an existing plant",
                "description": "Replaces the plant matching the provided id. All nine fields are required because this is a full replacement. Requires a session, log in with GitHub first.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "MongoDB ObjectId of the plant to update"
                    },
                    {
                        "name": "body",
                        "in": "body",
                        "description": "The new values for the plant. All nine fields are required. Do not send an _id.",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/PlantInput"
                        },
                        "example": {
                            "name": "Monstera",
                            "species": "Monstera deliciosa",
                            "category": "Tropical",
                            "nickname": "Delilah",
                            "location": "Bedroom",
                            "lightRequirement": "Medium Light",
                            "wateringIntervalDays": 10,
                            "acquiredDate": "2024-03-15",
                            "notes": "Moved away from the draft."
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK - The plant was updated.",
                        "schema": {
                            "$ref": "#/definitions/MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request - Invalid id, or one or more fields are missing or invalid.",
                        "schema": {
                            "$ref": "#/definitions/ValidationError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized - There is no active session.",
                        "schema": {
                            "$ref": "#/definitions/AuthError"
                        }
                    },
                    "404": {
                        "description": "Not Found - No plant exists with that id."
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                },
                "security": [
                    {
                        "sessionCookie": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Plants"
                ],
                "summary": "Delete a plant",
                "description": "Removes the plant matching the provided id. A plant that still has care logs returns 409. Requires a session, log in with GitHub first.",
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "MongoDB ObjectId of the plant to delete"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK - The plant was deleted.",
                        "schema": {
                            "$ref": "#/definitions/MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request - The id is not a valid ObjectId."
                    },
                    "401": {
                        "description": "Unauthorized - There is no active session.",
                        "schema": {
                            "$ref": "#/definitions/AuthError"
                        }
                    },
                    "404": {
                        "description": "Not Found - No plant exists with that id."
                    },
                    "409": {
                        "description": "Conflict - The plant still has care logs attached."
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                },
                "security": [
                    {
                        "sessionCookie": []
                    }
                ]
            }
        },
        "/careLogs/{id}": {
            "get": {
                "tags": [
                    "Care Logs"
                ],
                "summary": "Get a care log by id",
                "description": "Returns a single care log matching the provided id.",
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "MongoDB ObjectId of the care log"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK - Returns the requested care log.",
                        "schema": {
                            "$ref": "#/definitions/CareLog"
                        }
                    },
                    "400": {
                        "description": "Bad Request - The id is not a valid ObjectId."
                    },
                    "404": {
                        "description": "Not Found - No care log exists with that id."
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            },
            "put": {
                "tags": [
                    "Care Logs"
                ],
                "summary": "Update an existing care log",
                "description": "Replaces the care log matching the provided id. All five fields are required because this is a full replacement. Requires a session, log in with GitHub first.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "MongoDB ObjectId of the care log to update"
                    },
                    {
                        "name": "body",
                        "in": "body",
                        "description": "The new values for the care log. All five fields are required. Do not send an _id.",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CareLogInput"
                        },
                        "example": {
                            "plantId": "66a1b2c3d4e5f60718293a4b",
                            "taskType": "Fertilizing",
                            "performedDate": "2024-06-03",
                            "durationMinutes": 8,
                            "notes": "Used half strength liquid fertilizer."
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK - The care log was updated.",
                        "schema": {
                            "$ref": "#/definitions/MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request - Invalid id, or one or more fields are missing or invalid.",
                        "schema": {
                            "$ref": "#/definitions/ValidationError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized - There is no active session.",
                        "schema": {
                            "$ref": "#/definitions/AuthError"
                        }
                    },
                    "404": {
                        "description": "Not Found - No care log exists with that id, or plantId is unknown."
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                },
                "security": [
                    {
                        "sessionCookie": []
                    }
                ]
            },
            "delete": {
                "tags": [
                    "Care Logs"
                ],
                "summary": "Delete a care log",
                "description": "Removes the care log matching the provided id. Requires a session, log in with GitHub first.",
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "type": "string",
                        "description": "MongoDB ObjectId of the care log to delete"
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK - The care log was deleted.",
                        "schema": {
                            "$ref": "#/definitions/MessageResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request - The id is not a valid ObjectId."
                    },
                    "401": {
                        "description": "Unauthorized - There is no active session.",
                        "schema": {
                            "$ref": "#/definitions/AuthError"
                        }
                    },
                    "404": {
                        "description": "Not Found - No care log exists with that id."
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                },
                "security": [
                    {
                        "sessionCookie": []
                    }
                ]
            }
        },
        "/plants": {
            "get": {
                "tags": [
                    "Plants"
                ],
                "summary": "Get all plants",
                "description": "Returns every plant in the plants collection, sorted by name. Optionally filter with category or lightRequirement.",
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "category",
                        "in": "query",
                        "description": "Filter by plant category",
                        "required": false,
                        "type": "string",
                        "enum": [
                            "Succulent",
                            "Tropical",
                            "Fern",
                            "Orchid",
                            "Cactus",
                            "Palm",
                            "Herb",
                            "Other"
                        ]
                    },
                    {
                        "name": "lightRequirement",
                        "in": "query",
                        "description": "Filter by light requirement",
                        "required": false,
                        "type": "string",
                        "enum": [
                            "Low Light",
                            "Medium Light",
                            "Bright Indirect",
                            "Direct Sun"
                        ]
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK - Returns an array of plants.",
                        "schema": {
                            "$ref": "#/definitions/PlantList"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            },
            "post": {
                "tags": [
                    "Plants"
                ],
                "summary": "Create a new plant",
                "description": "Creates a plant in MongoDB. All nine fields are required. Do not send an _id, MongoDB assigns it. Requires a session, log in with GitHub first.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "description": "The plant to create. All nine fields are required.",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/PlantInput"
                        },
                        "example": {
                            "name": "Monstera",
                            "species": "Monstera deliciosa",
                            "category": "Tropical",
                            "nickname": "Delilah",
                            "location": "Living room window",
                            "lightRequirement": "Bright Indirect",
                            "wateringIntervalDays": 7,
                            "acquiredDate": "2024-03-15",
                            "notes": "Leaves started splitting after moving it closer to the window."
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created - Returns the id of the newly created plant.",
                        "schema": {
                            "$ref": "#/definitions/IdResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request - One or more fields are missing or invalid.",
                        "schema": {
                            "$ref": "#/definitions/ValidationError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized - There is no active session.",
                        "schema": {
                            "$ref": "#/definitions/AuthError"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                },
                "security": [
                    {
                        "sessionCookie": []
                    }
                ]
            }
        },
        "/careLogs": {
            "get": {
                "tags": [
                    "Care Logs"
                ],
                "summary": "Get all care logs",
                "description": "Returns every care log, newest first. Optionally filter by plantId or taskType.",
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "plantId",
                        "in": "query",
                        "description": "Only return care logs for this plant",
                        "required": false,
                        "type": "string"
                    },
                    {
                        "name": "taskType",
                        "in": "query",
                        "description": "Filter by task type",
                        "required": false,
                        "type": "string",
                        "enum": [
                            "Watering",
                            "Fertilizing",
                            "Repotting",
                            "Pruning",
                            "Pest Treatment",
                            "Repositioning"
                        ]
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK - Returns an array of care logs.",
                        "schema": {
                            "$ref": "#/definitions/CareLogList"
                        }
                    },
                    "400": {
                        "description": "Bad Request - The plantId query parameter is malformed."
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                }
            },
            "post": {
                "tags": [
                    "Care Logs"
                ],
                "summary": "Create a new care log",
                "description": "Creates a care log in MongoDB. All five fields are required and plantId must reference an existing plant. Requires a session, log in with GitHub first.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "parameters": [
                    {
                        "name": "body",
                        "in": "body",
                        "description": "The care log to create. All five fields are required.",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/CareLogInput"
                        },
                        "example": {
                            "plantId": "66a1b2c3d4e5f60718293a4b",
                            "taskType": "Watering",
                            "performedDate": "2024-06-01",
                            "durationMinutes": 12,
                            "notes": "Top watered until drainage came out."
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created - Returns the id of the newly created care log.",
                        "schema": {
                            "$ref": "#/definitions/IdResponse"
                        }
                    },
                    "400": {
                        "description": "Bad Request - One or more fields are missing or invalid.",
                        "schema": {
                            "$ref": "#/definitions/ValidationError"
                        }
                    },
                    "401": {
                        "description": "Unauthorized - There is no active session.",
                        "schema": {
                            "$ref": "#/definitions/AuthError"
                        }
                    },
                    "404": {
                        "description": "Not Found - The plantId does not match an existing plant."
                    },
                    "500": {
                        "description": "Internal Server Error"
                    }
                },
                "security": [
                    {
                        "sessionCookie": []
                    }
                ]
            }
        }
    },
    "definitions": {
        "PlantInput": {
            "description": "The nine fields required to create or replace a plant. The _id is generated by MongoDB and must not be sent.",
            "type": "object",
            "required": [
                "name",
                "species",
                "category",
                "nickname",
                "location",
                "lightRequirement",
                "wateringIntervalDays",
                "acquiredDate",
                "notes"
            ],
            "properties": {
                "name": {
                    "type": "string",
                    "example": "Monstera"
                },
                "species": {
                    "type": "string",
                    "example": "Monstera deliciosa"
                },
                "category": {
                    "type": "string",
                    "enum": [
                        "Succulent",
                        "Tropical",
                        "Fern",
                        "Orchid",
                        "Cactus",
                        "Palm",
                        "Herb",
                        "Other"
                    ],
                    "example": "Tropical"
                },
                "nickname": {
                    "type": "string",
                    "example": "Delilah"
                },
                "location": {
                    "type": "string",
                    "example": "Living room window"
                },
                "lightRequirement": {
                    "type": "string",
                    "enum": [
                        "Low Light",
                        "Medium Light",
                        "Bright Indirect",
                        "Direct Sun"
                    ],
                    "example": "Bright Indirect"
                },
                "wateringIntervalDays": {
                    "type": "integer",
                    "example": 7
                },
                "acquiredDate": {
                    "type": "string",
                    "description": "Past date in YYYY-MM-DD format.",
                    "example": "2024-03-15"
                },
                "notes": {
                    "type": "string",
                    "example": "Leaves started splitting after moving it closer to the window."
                }
            }
        },
        "Plant": {
            "description": "A stored plant, including the _id that MongoDB assigned on insert.",
            "type": "object",
            "required": [
                "name",
                "species",
                "category",
                "nickname",
                "location",
                "lightRequirement",
                "wateringIntervalDays",
                "acquiredDate",
                "notes"
            ],
            "properties": {
                "_id": {
                    "type": "string",
                    "description": "Assigned by MongoDB when the plant is created. Not sent by the client.",
                    "example": "6ab6bd0406634384d69bc582"
                },
                "name": {
                    "type": "string",
                    "example": "Monstera"
                },
                "species": {
                    "type": "string",
                    "example": "Monstera deliciosa"
                },
                "category": {
                    "type": "string",
                    "enum": [
                        "Succulent",
                        "Tropical",
                        "Fern",
                        "Orchid",
                        "Cactus",
                        "Palm",
                        "Herb",
                        "Other"
                    ],
                    "example": "Tropical"
                },
                "nickname": {
                    "type": "string",
                    "example": "Delilah"
                },
                "location": {
                    "type": "string",
                    "example": "Living room window"
                },
                "lightRequirement": {
                    "type": "string",
                    "enum": [
                        "Low Light",
                        "Medium Light",
                        "Bright Indirect",
                        "Direct Sun"
                    ],
                    "example": "Bright Indirect"
                },
                "wateringIntervalDays": {
                    "type": "integer",
                    "example": 7
                },
                "acquiredDate": {
                    "type": "string",
                    "example": "2024-03-15"
                },
                "notes": {
                    "type": "string",
                    "example": "Leaves started splitting after moving it closer to the window."
                }
            }
        },
        "PlantList": {
            "description": "A list of stored plants.",
            "type": "array",
            "items": {
                "$ref": "#/definitions/Plant"
            }
        },
        "CareLogInput": {
            "description": "The five fields required to create or replace a care log. plantId must reference an existing plant.",
            "type": "object",
            "required": [
                "plantId",
                "taskType",
                "performedDate",
                "durationMinutes",
                "notes"
            ],
            "properties": {
                "plantId": {
                    "type": "string",
                    "description": "ObjectId of the plant this log belongs to.",
                    "example": "6ab6bd0406634384d69bc582"
                },
                "taskType": {
                    "type": "string",
                    "enum": [
                        "Watering",
                        "Fertilizing",
                        "Repotting",
                        "Pruning",
                        "Pest Treatment",
                        "Repositioning"
                    ],
                    "example": "Watering"
                },
                "performedDate": {
                    "type": "string",
                    "description": "Past date in YYYY-MM-DD format.",
                    "example": "2024-06-01"
                },
                "durationMinutes": {
                    "type": "integer",
                    "example": 12
                },
                "notes": {
                    "type": "string",
                    "example": "Top watered until drainage came out."
                }
            }
        },
        "CareLog": {
            "description": "A stored care log, including the _id that MongoDB assigned on insert.",
            "type": "object",
            "required": [
                "plantId",
                "taskType",
                "performedDate",
                "durationMinutes",
                "notes"
            ],
            "properties": {
                "_id": {
                    "type": "string",
                    "description": "Assigned by MongoDB when the care log is created. Not sent by the client.",
                    "example": "6ab6bd0506634384d69bc583"
                },
                "plantId": {
                    "type": "string",
                    "example": "6ab6bd0406634384d69bc582"
                },
                "taskType": {
                    "type": "string",
                    "enum": [
                        "Watering",
                        "Fertilizing",
                        "Repotting",
                        "Pruning",
                        "Pest Treatment",
                        "Repositioning"
                    ],
                    "example": "Watering"
                },
                "performedDate": {
                    "type": "string",
                    "example": "2024-06-01"
                },
                "durationMinutes": {
                    "type": "integer",
                    "example": 12
                },
                "notes": {
                    "type": "string",
                    "example": "Top watered until drainage came out."
                }
            }
        },
        "CareLogList": {
            "description": "A list of stored care logs.",
            "type": "array",
            "items": {
                "$ref": "#/definitions/CareLog"
            }
        },
        "IdResponse": {
            "description": "The _id of a newly created document, assigned by MongoDB.",
            "type": "object",
            "properties": {
                "_id": {
                    "type": "string",
                    "example": "6ab6bd0406634384d69bc582"
                }
            }
        },
        "MessageResponse": {
            "description": "Confirmation that the requested change was applied.",
            "type": "object",
            "properties": {
                "message": {
                    "type": "string",
                    "example": "Plant updated successfully."
                }
            }
        },
        "ValidationError": {
            "description": "Returned when the request body fails validation.",
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Validation failed."
                },
                "details": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "example": [
                        "category is required.",
                        "wateringIntervalDays must be a whole number between 1 and 365."
                    ]
                }
            }
        },
        "NotFoundError": {
            "description": "Returned when no document matches the requested id.",
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "No plant found with id 6ab6bd0406634384d69bc582."
                }
            }
        },
        "SessionUser": {
            "description": "The GitHub profile behind the current session, as stored in the users collection.",
            "type": "object",
            "properties": {
                "authenticated": {
                    "type": "boolean",
                    "example": true
                },
                "user": {
                    "$ref": "#/definitions/User"
                }
            }
        },
        "User": {
            "description": "A user document. It is created the first time the person logs in with GitHub.",
            "type": "object",
            "required": [
                "githubId",
                "username",
                "displayName"
            ],
            "properties": {
                "_id": {
                    "type": "string",
                    "description": "Assigned by MongoDB when the user is created. Not sent by the client.",
                    "example": "6ab6bd0606634384d69bc584"
                },
                "githubId": {
                    "type": "string",
                    "description": "Numeric id GitHub gave the account. This is the only value kept in the session.",
                    "example": "12345678"
                },
                "username": {
                    "type": "string",
                    "example": "adab-code"
                },
                "displayName": {
                    "type": "string",
                    "example": "Ada"
                },
                "email": {
                    "type": "string",
                    "nullable": true,
                    "description": "Null when the person hides their address or the user:email scope was not granted.",
                    "example": "ada@example.com"
                },
                "avatarUrl": {
                    "type": "string",
                    "nullable": true,
                    "example": "https://avatars.githubusercontent.com/u/12345678"
                },
                "profileUrl": {
                    "type": "string",
                    "example": "https://github.com/adab-code"
                },
                "loginCount": {
                    "type": "integer",
                    "example": 3
                },
                "createdAt": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-09-29T15:04:05.000Z"
                },
                "lastLoginAt": {
                    "type": "string",
                    "format": "date-time",
                    "example": "2026-09-29T18:22:41.000Z"
                }
            }
        },
        "AuthError": {
            "description": "Returned when a protected route is called without an active session.",
            "type": "object",
            "properties": {
                "error": {
                    "type": "string",
                    "example": "Authentication required. Log in with GitHub at /auth/github and try again."
                }
            }
        }
    }
}
